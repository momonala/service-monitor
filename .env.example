# Copy to .env and customize for local development (CI uses these stub values as-is).
TELEGRAM_API_TOKEN=0000000000:ci-telegram-token
TELEGRAM_CHAT_ID=0000000000
GITHUB_TOKEN=ci-github-token
INSPECTOR_DETECTOR_UV_PATH=/usr/bin/uv
INSPECTOR_DETECTOR_CWD=/tmp/inspector_detector
CLOUDFLARE_ACCOUNT_ID=ci-cloudflare-account-id
